<div class="action-bar">
  <a href="/latex/reasoning-llm-policy/index.html" target="_blank" rel="noopener">Open full page</a>
  <a href="/latex/reasoning-llm-policy/paper.pdf" target="_blank" rel="noopener">Download PDF</a>

    <item>
      <title>Clinical Encounters</title>
      <link>https://metafunctor.com/medical/encounters/</link>
      <pubDate>Wed, 15 Nov 2023 00:00:00 +0000</pubDate>
      <dc:creator>Alex Towell</dc:creator>

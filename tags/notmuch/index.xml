</span></span><span class="line"><span class="cl">    <span class="nb">id</span><span class="p">:</span> <span class="nb">str</span>                    <span class="c1"># Message-ID</span>
</span></span><span class="line"><span class="cl">    <span class="n">thread_id</span><span class="p">:</span> <span class="nb">str</span>             <span class="c1"># Thread identifier</span>
